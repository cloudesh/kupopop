<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Author>cloudesh</Author>
    <Name>Kupo Skribbl</Name>
    <Punchline>A drawing and guessing party game, right inside FFXIV.</Punchline>
    <Description>Kupo Skribbl is a drawing and guessing pictionary game. Each player takes turns to draw their chosen word and others have to guess it to gain points! The person with the most points is the winner!

Open with /kupopop or /kuposkribbl.</Description>
    <IconUrl>https://raw.githubusercontent.com/cloudesh/kupopop/main/plugin/images/icon.png</IconUrl>
    <RepoUrl>https://github.com/cloudesh/kupopop</RepoUrl>
    <Tags>drawing;game;multiplayer;social</Tags>
    <Use_Dalamud_FFXIVClientStructs>false</Use_Dalamud_FFXIVClientStructs>
    <Use_Dalamud_Lumina>false</Use_Dalamud_Lumina>
    <Use_Dalamud_Lumina_Excel>false</Use_Dalamud_Lumina_Excel>
    <Use_Dalamud_Serilog>false</Use_Dalamud_Serilog>
    <Use_Dalamud_MSObjectPool>false</Use_Dalamud_MSObjectPool>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Kupopop.Shared/Kupopop.Shared.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Audio/*.wav" /></ItemGroup>
</Project>
