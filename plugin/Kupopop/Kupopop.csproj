<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Author>cloudesh</Author>
    <Name>Kupo Skribbl</Name>
    <Punchline>A multiplayer Pictionary-style drawing game inside FFXIV.</Punchline>
    <Description>Kupo Skribbl is a multiplayer Pictionary-style drawing and guessing game inside Final Fantasy XIV for 2–16 players. Take turns choosing a word and drawing it while everyone else guesses; the player with the most points wins. Includes private rooms, public lobbies, friends and custom drawn portraits. Everyone connects automatically to our shared server—no server setup required.

Open with /kupo, /kupopop or /kuposkribbl.</Description>
    <IconUrl>https://raw.githubusercontent.com/cloudesh/kupopop/main/plugin/images/icon.png?v=$(Version)</IconUrl>
    <RepoUrl>https://github.com/cloudesh/kupopop</RepoUrl>
    <Tags>pictionary;drawing;game;multiplayer;social</Tags>
    <Use_Dalamud_FFXIVClientStructs>false</Use_Dalamud_FFXIVClientStructs>
    <Use_Dalamud_Lumina>false</Use_Dalamud_Lumina>
    <Use_Dalamud_Lumina_Excel>false</Use_Dalamud_Lumina_Excel>
    <Use_Dalamud_Serilog>false</Use_Dalamud_Serilog>
    <Use_Dalamud_MSObjectPool>false</Use_Dalamud_MSObjectPool>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Kupopop.Shared/Kupopop.Shared.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Audio/*.wav" /></ItemGroup>
  <ItemGroup><Content Include="../images/icon.png" Link="images/icon.png" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
